;; ==========================================
;; 1. VARIABLES AND POLLS
;; ==========================================
(defpoll my_notifications
  :interval "2s"
  `cat /data/data/com.termux/files/usr/tmp/notifs.json`)

(defvar current_screenshot "")

;; Music Variables (Audacious)
(defpoll audacious_title :interval "1s" "audtool current-song-tuple-data title")
(defpoll audacious_artist :interval "1s" "audtool current-song-tuple-data artist")
;; NOTE: Remember to change this path to a real image on your device, otherwise nothing will show up.
(defvar audacious_cover "/data/data/com.termux/files/home/path/to/your/image.jpg") 

;; ==========================================
;; 2. WIDGETS
;; ==========================================

;; WIDGET: SCREENSHOT POPUP (WITH IMAGE AND BUTTONS)
(defwidget screenshot_popup_widget []
  (eventbox
    :onclick "eww close popup_screenshot -c ~/.config/eww/notifications &"
    (box
      :orientation "vertical"
      :space-evenly false
      :style "background-color: rgba(2, 6, 18, 0.98);
              border-radius: 24px;
              padding: 15px 20px;
              border: 1px solid #1a233a;"

      (box
        :orientation "horizontal"
        :space-evenly false
        :spacing 12
        :valign "center"
        :style "margin-bottom: 12px;"
        (box
          :style "background-image: url('${current_screenshot}');
                  background-size: cover;
                  background-position: center;
                  min-width: 32px;
                  min-height: 32px;
                  border-radius: 50%;")
        (label
          :text "Screenshot"
          :style "color: #c0caf5; font-size: 16px; font-weight: bold;")
      )

      (box
        :style "background-color: #c0caf5;
                min-height: 1px;
                margin-bottom: 18px;")

      (box
        :orientation "vertical"
        :space-evenly false
        :spacing 6
        :style "margin-bottom: 22px;"
        (label
          :text "Screenshot Is Ready!"
          :halign "center"
          :style "color: #c0caf5; font-size: 18px; font-weight: bold;")
        (label
          :text "Screenshot saved successfully"
          :halign "center"
          :style "color: #c0caf5; font-size: 14px;")
      )

      (box
        :orientation "horizontal"
        :space-evenly true
        :spacing 15
        (button
          :onclick "bash ~/.config/eww/scripts/screenshot_actions.sh copy '${current_screenshot}' &"
          :style "background-color: #1a1b26;
                  color: #c0caf5;
                  padding: 8px;
                  border-radius: 20px;
                  font-size: 14px;
                  font-weight: bold;
                  border: 1px solid #292e42;"
          "Copy")
        (button
          :onclick "bash ~/.config/eww/scripts/screenshot_actions.sh delete '${current_screenshot}' &"
          :style "background-color: #1a1b26;
                  color: #c0caf5;
                  padding: 8px;
                  border-radius: 20px;
                  font-size: 14px;
                  font-weight: bold;
                  border: 1px solid #292e42;"
          "Delete")
      )
    )
  )
)

;; WIDGET: DELETED SCREENSHOT POPUP
(defwidget screenshot_deleted_popup_widget []
  (eventbox
    :onclick "eww close popup_screenshot_deleted -c ~/.config/eww/notifications &"
    (box
      :orientation "vertical"
      :space-evenly false
      :style "background-color: rgba(2, 6, 18, 0.98);
              border-radius: 24px;
              padding: 15px 20px;
              border: 1px solid #1a233a;"

      (box
        :orientation "horizontal"
        :space-evenly false
        :spacing 12
        :valign "center"
        :style "margin-bottom: 12px;"
        (label
          :text ""
          :style "color: #7aa2f7; font-size: 26px; margin-right: 6px;")
        (label
          :text "Screenshot"
          :style "color: #c0caf5; font-size: 16px; font-weight: bold;")
      )

      (box
        :style "background-color: #c0caf5;
                min-height: 1px;
                margin-bottom: 18px;")

      (box
        :orientation "vertical"
        :space-evenly false
        :spacing 6
        :style "margin-bottom: 10px;"
        (label
          :text "Screenshot"
          :halign "center"
          :style "color: #c0caf5; font-size: 18px; font-weight: bold;")
        (label
          :text "Screenshot removed successfully."
          :halign "center"
          :style "color: #c0caf5; font-size: 14px;")
      )
    )
  )
)

